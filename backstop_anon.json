{
  "id": "backstop_default",
  "viewports": [
    {
      "label": "phone",
      "width": 375,
      "height": 667
    },
    {
      "label": "tablet",
      "width": 768,
      "height": 1024
    },
    {
      "label": "desktop",
      "width": 1440,
      "height": 1080
    }
  ],
  "scenarios": [
    {
      "label": "homepage",
      "url": "%%URI%%",
      "removeSelectors": ["#admin-menu", "#messages"]
    }
  ],
  "paths": {
    "bitmaps_reference": "data/anon/bitmaps_reference",
    "bitmaps_test": "data/anon/bitmaps_test",
    "engine_scripts": "library/engine_scripts",
    "html_report": "data/anon/html_report",
    "ci_report": "data/anon/ci_report"
  },
  "report": ["browser", "CI"],
  "engine": "puppeteer",
  "engineOptions": {
    "ignoreHTTPSErrors": true,
    "args": [
      "--no-sandbox",
      "--disable-setuid-sandbox",
      "--disable-dev-shm-usage",
      "--ignore-gpu-blocklist",
      "--enable-unsafe-swiftshader",
      "--use-gl=angle",
      "--use-angle=swiftshader"
    ]
  },
  "engineFlags": [],
  "asyncCaptureLimit": 2,
  "asyncCompareLimit": 4,
  "misMatchThreshold": 1,
  "debug": false,
  "debugWindow": false,
  "cliExitOnFail": true
}
